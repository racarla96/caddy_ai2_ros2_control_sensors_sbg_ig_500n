{#
  Fragment: injectable into a <model> block.

  The link origin is at the center of the SBG IG-500N body (mounting point).
  Physical dimensions: 46 mm × 45 mm × 21 mm, mass 0.26 kg.

  Hardcoded sensor constants:
    mass = 0.26 kg  |  frame_id = imu_link
    gyro noise:  gaussian mean=0.0 stddev=0.001 rad/s
    accel noise: gaussian mean=0.0 stddev=0.01 m/s²
    navsat noise: horizontal/vertical stddev=0.5 m

  Variables always required:
    prefix, parent_link, x, y, z, roll, pitch, yaw
    include_parent_joint (default true)
    with_sensor          (default true)

  Additional variables required only when with_sensor=true:
    namespace, update_rate
#}

{% if parent_link == "map" %}
  <link name="{{ parent_link }}"/>
{% endif %}

  <link name="{{ prefix }}imu_link">
{% if include_parent_joint | default(true) %}
    <pose>{{ x }} {{ y }} {{ z }} {{ roll }} {{ pitch }} {{ yaw }}</pose>
{% else %}
    <pose>0 0 0 0 0 0</pose>
{% endif %}
    <visual name="{{ prefix }}imu_visual">
      <geometry>
        <box><size>0.046 0.045 0.021</size></box>
      </geometry>
      <material>
        <ambient>0.2 0.2 0.2 1</ambient>
        <diffuse>0.3 0.3 0.3 1</diffuse>
      </material>
    </visual>
    <collision name="{{ prefix }}imu_collision">
      <geometry>
        <box><size>0.046 0.045 0.021</size></box>
      </geometry>
    </collision>
    <inertial>
      <mass>0.26</mass>
      <inertia>
        <ixx>0.0000534</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0000554</iyy><iyz>0</iyz><izz>0.0000897</izz>
      </inertia>
    </inertial>
{% if with_sensor | default(true) %}
    <sensor name="{{ prefix }}imu" type="imu">
      <gz_frame_id>{{ prefix }}imu_link</gz_frame_id>
{% if namespace %}
      <topic>/{{ namespace }}/imu</topic>
{% else %}
      <topic>/imu</topic>
{% endif %}
      <update_rate>{{ update_rate }}</update_rate>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <always_on>true</always_on>
    </sensor>
    <sensor name="{{ prefix }}navsat" type="navsat">
      <gz_frame_id>{{ prefix }}imu_link</gz_frame_id>
{% if namespace %}
      <topic>/{{ namespace }}/navsat</topic>
{% else %}
      <topic>/navsat</topic>
{% endif %}
      <update_rate>1</update_rate>
      <navsat>
        <horizontal_position_noise>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.5</stddev></noise>
        </horizontal_position_noise>
        <vertical_position_noise>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.5</stddev></noise>
        </vertical_position_noise>
        <horizontal_velocity_noise>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.1</stddev></noise>
        </horizontal_velocity_noise>
        <vertical_velocity_noise>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.1</stddev></noise>
        </vertical_velocity_noise>
      </navsat>
      <always_on>true</always_on>
    </sensor>
{% endif %}
  </link>

  <joint name="{{ prefix }}imu_joint" type="fixed">
    <parent>{{ parent_link }}</parent>
    <child>{{ prefix }}imu_link</child>
  </joint>
